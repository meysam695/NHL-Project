"""
Dynamic Programming Example: Longest Common Subsequence (LCS)
Author: Meysam Zouraghifazel
Description:
This code demonstrates how to compute the longest common subsequence between
two strings using dynamic programming. It is readable, modular, and efficient.
"""

def lcs(X, Y):
    """
    Compute the length of the Longest Common Subsequence between X and Y.
    Returns the LCS length and the LCS itself.
    """
    m, n = len(X), len(Y)
    dp = [[0]*(n+1) for _ in range(m+1)]

    # Build the dp table
    for i in range(1, m+1):
        for j in range(1, n+1):
            if X[i-1] == Y[j-1]:
                dp[i][j] = dp[i-1][j-1] + 1
            else:
                dp[i][j] = max(dp[i-1][j], dp[i][j-1])

    # Reconstruct the LCS
    i, j = m, n
    lcs_seq = []
    while i > 0 and j > 0:
        if X[i-1] == Y[j-1]:
            lcs_seq.append(X[i-1])
            i -= 1
            j -= 1
        elif dp[i-1][j] > dp[i][j-1]:
            i -= 1
        else:
            j -= 1

    lcs_seq.reverse()
    return dp[m][n], ''.join(lcs_seq)

# Example usage
if __name__ == "__main__":
    X = "AGGTAB"
    Y = "GXTXAYB"
    length, sequence = lcs(X, Y)
    print(f"LCS length: {length}")
    print(f"LCS sequence: {sequence}")
