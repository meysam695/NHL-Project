"""
Graph Algorithms: BFS and DFS
Author: Meysam Zouraghifazel
Description:
This module demonstrates breadth-first search (BFS) and depth-first search (DFS)
on a graph represented as an adjacency list. The code is modular, readable, and
follows Pythonic style.
"""

from collections import deque

class Graph:
    def __init__(self):
        self.adj_list = {}

    def add_edge(self, u, v):
        """Add an undirected edge between nodes u and v."""
        if u not in self.adj_list:
            self.adj_list[u] = []
        if v not in self.adj_list:
            self.adj_list[v] = []
        self.adj_list[u].append(v)
        self.adj_list[v].append(u)

    def bfs(self, start):
        """Perform Breadth-First Search starting from 'start' node."""
        visited = set()
        queue = deque([start])
        result = []

        while queue:
            node = queue.popleft()
            if node not in visited:
                visited.add(node)
                result.append(node)
                queue.extend([neighbor for neighbor in self.adj_list[node] if neighbor not in visited])
        return result

    def dfs(self, start):
        """Perform Depth-First Search starting from 'start' node."""
        visited = set()
        result = []

        def dfs_recursive(node):
            if node not in visited:
                visited.add(node)
                result.append(node)
                for neighbor in self.adj_list[node]:
                    dfs_recursive(neighbor)

        dfs_recursive(start)
        return result

# Example usage
if __name__ == "__main__":
    graph = Graph()
    edges = [(0,1), (0,2), (1,3), (1,4), (2,5), (4,5)]
    for u, v in edges:
        graph.add_edge(u, v)

    print("BFS Traversal:", graph.bfs(0))
    print("DFS Traversal:", graph.dfs(0))
